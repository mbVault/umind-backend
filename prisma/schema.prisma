generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum LifeStage {
  GROWING_UP // 12–19
  STARTING_OUT // 20–30
  BUILDING // 30–45
  SHIFTING // 45–60
  WISDOM_YEARS // 60+
}

enum Gender {
  WOMAN
  MAN
  PREFER_NOT_TO_SAY
}

enum StartingFeeling {
  STRESSED
  ANXIOUS
  GHABRAHAT
  LOW
  CANT_SLEEP
  LONELY
}

enum AppTheme {
  LAVENDER
  OCEAN
  FOREST
  SUNSET
  ROSE
}

enum SaathiCheckInTime {
  MORNING
  AFTERNOON
  EVENING
  BEFORE_BED
  ONLY_WHEN_I_OPEN
}

enum SaathiLanguage {
  HINDI
  ENGLISH
  HINGLISH
}

enum UnwindHabit {
  BREATHING
  WALKING
  TALKING_IT_OUT
  CALM_SOUNDS
  WRITING
  AYURVEDA_ROUTINES
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  alias               String            @db.VarChar(20)
  avatarId            String            @db.VarChar(50)
  lifeStage           LifeStage
  gender              Gender
  startingFeelings    StartingFeeling[]
  appTheme            AppTheme          @default(LAVENDER)
  city                String            @default("") @db.VarChar(100)
  saathiCheckIn       SaathiCheckInTime
  saathiLanguage      SaathiLanguage
  unwindHabits        UnwindHabit[]
  recoveryKeyVerifier String            @db.Text
  status              UserStatus        @default(ACTIVE)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?         @db.Timestamptz(6)

  shareDiaryWithSaathi     Boolean   @default(false)
  shareDiaryConsentVersion Int?
  shareDiaryConsentAt      DateTime? @db.Timestamptz(6)
  diaryKdfSalt             Bytes?
  diaryKeyVersion          Int       @default(1)

  deviceRegistrations UserDevice[]
  sessions            AuthSession[]
  psychologistBookings PsychologistBooking[]
  subscriptions       Subscription[]
  orders              Order[]
  attendanceEvents    AttendanceEvent[]
  sessionComplaints   SessionComplaint[]
  recordingConsents   SessionRecordingConsent[]
  saathiConversations SaathiConversation[]
  userMoods           UserMood[]
  diaryEntries        DiaryEntry[]
}

model Device {
  id         String    @id @default(uuid()) @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt DateTime? @db.Timestamptz(6)

  registrations UserDevice[]
}

model UserDevice {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  deviceId     String    @db.Uuid
  registeredAt DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt   DateTime? @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)

  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  device   Device        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  sessions AuthSession[]

  @@unique([id, userId])
  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  userDeviceId     String?   @db.Uuid
  refreshTokenHash String    @unique @db.Text
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt       DateTime? @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  userDevice UserDevice? @relation(fields: [userDeviceId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId])
  @@index([userDeviceId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Staff identity (psychologists + admins) — SuperTokens-backed, separate from
// anonymous client User / AuthSession above.
// ---------------------------------------------------------------------------

enum AccountStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum StaffRole {
  PSYCHOLOGIST
  ADMIN
}

enum ProfileVisibilityMode {
  REAL_NAME_AND_PHOTO
  DISPLAY_NAME_AND_AVATAR
}

enum PsychologistPublicationStatus {
  NOT_SUBMITTED
  PENDING_VERIFICATION
  VERIFIED_UNPUBLISHED
  LIVE
  NEEDS_ATTENTION
}

enum PsychologistAccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PsychologistOnboardingStep {
  APPLY
  PROFILE
  DOCUMENTS
  BACKGROUND_CHECK
  HOURS
  COMPLETE
}

/// HR screening only — set by admin approve/reject, not by the applicant.
enum PsychologistHrApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// Hours screen: LIVE psychs toggle Online/Away for client bookability.
enum PsychologistPresence {
  ONLINE
  AWAY
}

/// After-session risk; URGENT must escalate to safety ops + Tele-MANAS (API layer).
enum SessionRiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SpecialisationCode {
  STRESS
  ANXIETY
  SLEEP
  BURNOUT
  RELATIONSHIPS
  TEENS
  WOMENS_HEALTH
  GRIEF
}

enum LanguageCode {
  HINDI
  ENGLISH
  MARATHI
  PUNJABI
  TAMIL
}

enum IdDocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENCE
}

enum PsychologistDocumentKind {
  ID_FRONT
  ID_BACK
  LIVE_SELFIE
  PASSPORT_PHOTO
  DEGREE_CERTIFICATE
  RCI_CERTIFICATE
  EXPERIENCE_LETTER
}

enum DocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  REPLACED
  REJECTED_NEED_REUPLOAD
}

enum VerificationCheckType {
  IDENTITY
  RCI_REGISTRATION
  DEGREE
  YEARS_OF_EXPERIENCE
}

enum VerificationCheckStatus {
  QUEUED
  IN_PROGRESS
  VERIFIED
  NEEDS_ATTENTION
}

enum AdminMembershipStatus {
  ACTIVE
  DISABLED
  REVOKED
}

enum AdminRoleCode {
  FOUNDER_SUPER_ADMIN
  VERIFICATION_OFFICER
  SAFETY_LEAD
  FINANCE
  CONTENT_EDITOR
}

enum AdminInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuditActorType {
  ADMIN
  SYSTEM
}

model Account {
  id                String        @id @default(uuid()) @db.Uuid
  superTokensUserId String        @unique @db.VarChar(128)
  email             String?       @db.VarChar(320)
  status            AccountStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?     @db.Timestamptz(6)

  roles                  AccountRole[]
  psychologistProfile    PsychologistProfile?
  adminMembership        AdminMembership?
  uploadedDocuments      PsychologistDocument[]       @relation("DocumentUploader")
  reviewedChecks         PsychologistVerificationCheck[] @relation("CheckReviewer")
  invitationsSent         AdminInvitation[]             @relation("InvitationInviter")
  invitationsAccepted     AdminInvitation[]             @relation("InvitationAcceptor")
  auditLogs               AdminAuditLog[]               @relation("AuditActor")
  membershipRolesAssigned AdminMembershipRole[]         @relation("MembershipRoleAssigner")
  membershipsInvited      AdminMembership[]             @relation("MembershipInviter")
  complaintsReviewed      SessionComplaint[]

  @@index([status])
}

model AccountRole {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @db.Uuid
  role      StaffRole
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, role])
  @@index([role, accountId])
}

model PsychologistProfile {
  id                     String                        @id @default(uuid()) @db.Uuid
  accountId              String                        @unique @db.Uuid
  legalFullName          String?                       @db.VarChar(120)
  visibilityMode         ProfileVisibilityMode         @default(DISPLAY_NAME_AND_AVATAR)
  displayName            String?                       @db.VarChar(80)
  publicPhotoObjectKey   String?                       @db.VarChar(512)
  avatarColor            String?                       @db.VarChar(16)
  avatarInitials         String?                       @db.VarChar(4)
  rciRegistrationNumber  String?                       @unique @db.VarChar(64)
  highestDegree          String?                       @db.VarChar(120)
  yearsPractising        Int?
  idDocumentType         IdDocumentType?
  aadhaarLast4           String?                       @db.Char(4)
  onboardingStep         PsychologistOnboardingStep    @default(APPLY)
  applicationSubmittedAt DateTime?                     @db.Timestamptz(6)
  /// HR screening: only admin approve/reject changes this (default pending).
  hrApprovalStatus       PsychologistHrApprovalStatus  @default(PENDING_APPROVAL)
  hrReviewedAt           DateTime?                     @db.Timestamptz(6)
  hrReviewedByAccountId  String?                       @db.Uuid
  hrRejectionReason      String?                       @db.VarChar(500)
  publicationStatus      PsychologistPublicationStatus @default(NOT_SUBMITTED)
  accountStatus          PsychologistAccountStatus     @default(ACTIVE)
  publishedAt            DateTime?                     @db.Timestamptz(6)
  suspendedAt            DateTime?                     @db.Timestamptz(6)
  suspensionReason       String?                       @db.VarChar(500)
  /// Today/Hours: Online = eligible for new bookings (with other bookable gates).
  presence               PsychologistPresence          @default(ONLINE)
  /// Hours: hard stop on new client bookings when false (existing confirmed stay).
  acceptingNewClients    Boolean                       @default(true)
  /// Hours: null = no daily cap; enforced at booking time against confirmed sessions that day.
  maxSessionsPerDay      Int?
  /// Hours: modes this psych offers; booking.communicationMode must be ⊆ this set.
  sessionModes           CommunicationMode[]           @default([])
  /// Hours template: { "mon":[{"start":"09:00","end":"12:00"}], ... "sun":[...] }.
  /// Concrete bookable rows still live in PsychologistAvailabilitySlot.
  weeklyHours            Json?
  createdAt              DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                      @updatedAt @db.Timestamptz(6)

  account         Account                       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  specialisations PsychologistSpecialisation[]
  languages       PsychologistLanguage[]
  documents       PsychologistDocument[]
  checks          PsychologistVerificationCheck[]
  bookings        PsychologistBooking[]
  availabilitySlots PsychologistAvailabilitySlot[]
  attendanceEvents AttendanceEvent[]
  recordingConsents SessionRecordingConsent[]
  payouts         PsychologistPayout[]

  @@index([publicationStatus])
  @@index([accountStatus])
  @@index([applicationSubmittedAt])
  @@index([hrApprovalStatus, applicationSubmittedAt])
  @@index([publicationStatus, presence, acceptingNewClients])
}

model PsychologistSpecialisation {
  psychologistProfileId String             @db.Uuid
  code                  SpecialisationCode

  psychologist PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)

  @@id([psychologistProfileId, code])
  @@index([code])
}

model PsychologistLanguage {
  psychologistProfileId String       @db.Uuid
  code                  LanguageCode

  psychologist PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)

  @@id([psychologistProfileId, code])
  @@index([code])
}

model PsychologistDocument {
  id                    String                   @id @default(uuid()) @db.Uuid
  psychologistProfileId String                   @db.Uuid
  kind                  PsychologistDocumentKind
  storageObjectKey      String                   @unique @db.VarChar(512)
  contentType           String                   @db.VarChar(100)
  byteSize              Int
  checksum              String?                  @db.Char(64)
  status                DocumentStatus           @default(PENDING_UPLOAD)
  uploadedAt            DateTime?                @db.Timestamptz(6)
  replacedAt            DateTime?                @db.Timestamptz(6)
  rejectionReason       String?                  @db.VarChar(500)
  uploadedByAccountId   String?                  @db.Uuid
  replacesDocumentId    String?                  @db.Uuid
  createdAt             DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(6)

  psychologist   PsychologistProfile  @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)
  uploadedBy     Account?             @relation("DocumentUploader", fields: [uploadedByAccountId], references: [id], onDelete: SetNull)
  replaces       PsychologistDocument?  @relation("DocumentReplacement", fields: [replacesDocumentId], references: [id], onDelete: Restrict)
  replacedBy     PsychologistDocument[] @relation("DocumentReplacement")

  @@index([psychologistProfileId, kind])
  @@index([status])
}

model PsychologistVerificationCheck {
  id                    String                  @id @default(uuid()) @db.Uuid
  psychologistProfileId String                  @db.Uuid
  type                  VerificationCheckType
  status                VerificationCheckStatus @default(QUEUED)
  reviewerAccountId     String?                 @db.Uuid
  reason                String?                 @db.VarChar(1000)
  reviewedAt            DateTime?               @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(6)

  psychologist PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)
  reviewer     Account?            @relation("CheckReviewer", fields: [reviewerAccountId], references: [id], onDelete: SetNull)

  @@unique([psychologistProfileId, type])
  @@index([status, type])
  @@index([psychologistProfileId, status])
}

model AdminMembership {
  id                 String                @id @default(uuid()) @db.Uuid
  accountId          String                @unique @db.Uuid
  status             AdminMembershipStatus @default(ACTIVE)
  invitedByAccountId String?               @db.Uuid
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)
  revokedAt          DateTime?             @db.Timestamptz(6)

  account    Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  invitedBy  Account?              @relation("MembershipInviter", fields: [invitedByAccountId], references: [id], onDelete: SetNull)
  roles      AdminMembershipRole[]
  invitation AdminInvitation?

  @@index([status])
}

model AdminRole {
  id        String        @id @default(uuid()) @db.Uuid
  code      AdminRoleCode @unique
  name      String        @db.VarChar(80)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  memberships AdminMembershipRole[]
  permissions AdminRolePermission[]
}

model AdminMembershipRole {
  adminMembershipId   String   @db.Uuid
  adminRoleId         String   @db.Uuid
  assignedByAccountId String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  membership AdminMembership @relation(fields: [adminMembershipId], references: [id], onDelete: Restrict)
  role       AdminRole       @relation(fields: [adminRoleId], references: [id], onDelete: Restrict)
  assignedBy Account?        @relation("MembershipRoleAssigner", fields: [assignedByAccountId], references: [id], onDelete: SetNull)

  @@id([adminMembershipId, adminRoleId])
}

model AdminPermission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(80)
  description String? @db.VarChar(255)

  roles AdminRolePermission[]
}

model AdminRolePermission {
  adminRoleId       String @db.Uuid
  adminPermissionId String @db.Uuid

  role       AdminRole       @relation(fields: [adminRoleId], references: [id], onDelete: Restrict)
  permission AdminPermission @relation(fields: [adminPermissionId], references: [id], onDelete: Restrict)

  @@id([adminRoleId, adminPermissionId])
}

model AdminInvitation {
  id                    String                @id @default(uuid()) @db.Uuid
  email                 String                @db.VarChar(320)
  tokenHash             String                @unique @db.Text
  status                AdminInvitationStatus @default(PENDING)
  invitedByAccountId    String                @db.Uuid
  roleCodes             AdminRoleCode[]
  expiresAt             DateTime              @db.Timestamptz(6)
  acceptedAt            DateTime?             @db.Timestamptz(6)
  acceptedByAccountId   String?               @db.Uuid
  revokedAt             DateTime?             @db.Timestamptz(6)
  resultingMembershipId String?               @unique @db.Uuid
  createdAt             DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(6)

  invitedBy           Account          @relation("InvitationInviter", fields: [invitedByAccountId], references: [id], onDelete: Restrict)
  acceptedBy          Account?         @relation("InvitationAcceptor", fields: [acceptedByAccountId], references: [id], onDelete: SetNull)
  resultingMembership AdminMembership? @relation(fields: [resultingMembershipId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([status, expiresAt])
  @@index([invitedByAccountId])
}

model AdminAuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  actorAccountId String?        @db.Uuid
  actorType      AuditActorType
  action         String         @db.VarChar(80)
  targetType     String         @db.VarChar(64)
  targetId       String?        @db.VarChar(64)
  metadata       Json?
  ipAddress      String?        @db.VarChar(64)
  userAgent      String?        @db.VarChar(512)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  actor Account? @relation("AuditActor", fields: [actorAccountId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([actorAccountId])
}

// ---------------------------------------------------------------------------
// Booking, payments, subscriptions, sessions (client User + PsychologistProfile)
// ---------------------------------------------------------------------------

enum CommunicationMode {
  CHAT
  VOICE
  VIDEO
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum CancelledByParty {
  CUSTOMER
  PSYCHOLOGIST
  STAFF
  SYSTEM
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  INTERRUPTED
  CANCELLED
  NO_SHOW
  DISPUTED
}

enum ParticipantRole {
  CUSTOMER
  PSYCHOLOGIST
}

enum AttendanceEventType {
  JOINED
  LEFT
  RECONNECTED
  DISCONNECTED
}

enum RecordingStatus {
  NOT_APPLICABLE
  CONSENT_PENDING
  CONSENTED
  RECORDING
  AVAILABLE
  FAILED
  DELETED
}

enum OrderPurpose {
  PSYCHOLOGIST_BOOKING
  SUBSCRIPTION
}

enum OrderStatus {
  CREATED
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum RefundReason {
  CUSTOMER_CANCEL
  CUSTOMER_LATE_CANCEL
  PSYCHOLOGIST_CANCEL
  PSYCHOLOGIST_NO_SHOW
  COMPLAINT_FULL
  COMPLAINT_PARTIAL
  PAYMENT_AFTER_SLOT_RELEASED
  ADMIN_ADJUSTMENT
  OTHER
}

enum PaymentStatusChangeSource {
  WEBHOOK
  PROVIDER_API
  RECONCILIATION
  ADMIN
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum BillingMode {
  MANUAL
  AUTOMATIC
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  TRIAL_EXPIRED
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PlanInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ComplaintStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ComplaintCategory {
  SILENT_PSYCHOLOGIST
  INAUDIBLE
  UNRESPONSIVE
  DISRUPTED
  NOT_DELIVERED
  OTHER
}

enum ComplaintDecision {
  FULL_REFUND
  PARTIAL_REFUND
  NO_REFUND
  FREE_RESCHEDULE
}

model PsychologistAvailabilitySlot {
  id                    String              @id @default(uuid()) @db.Uuid
  psychologistProfileId String              @db.Uuid
  startsAt              DateTime            @db.Timestamptz(6)
  endsAt                DateTime            @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)

  psychologist PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)

  @@unique([psychologistProfileId, startsAt])
  @@index([psychologistProfileId, startsAt])
}

model PsychologistBooking {
  id                       String            @id @default(uuid()) @db.Uuid
  userId                   String            @db.Uuid
  psychologistProfileId    String            @db.Uuid
  scheduledStartAt         DateTime          @db.Timestamptz(6)
  scheduledEndAt           DateTime          @db.Timestamptz(6)
  durationMinutes          Int               @default(40)
  communicationMode        CommunicationMode
  status                   BookingStatus     @default(PENDING_PAYMENT)
  reservationExpiresAt     DateTime?         @db.Timestamptz(6)
  cancelledAt              DateTime?         @db.Timestamptz(6)
  cancelledByParty         CancelledByParty?
  cancellationReason       String?           @db.VarChar(1000)
  policyVersion            String            @db.VarChar(32)
  policySnapshot           Json?
  rescheduledFromBookingId String?           @db.Uuid
  customerRescheduleCount  Int               @default(0)
  isFreeProviderReschedule Boolean           @default(false)
  problemSnapshot          Json?
  /// Client booking privacy: opt-in Saathi summary for psych brief (never full chat/diary).
  shareSaathiSummary       Boolean           @default(false)
  /// Client booking privacy: opt-in recent mood history for psych brief.
  shareMoodHistory         Boolean           @default(false)
  createdAt                DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(6)

  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  psychologist      PsychologistProfile   @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)
  rescheduledFrom   PsychologistBooking?  @relation("BookingReschedule", fields: [rescheduledFromBookingId], references: [id], onDelete: Restrict)
  rescheduledTo     PsychologistBooking[] @relation("BookingReschedule")
  complaintReplacement SessionComplaint?  @relation("ComplaintReplacementBooking")
  orders            Order[]
  session           PsychologistSession?

  @@index([userId, status])
  @@index([psychologistProfileId, scheduledStartAt])
  @@index([status, reservationExpiresAt])
  @@index([rescheduledFromBookingId])
}

model PsychologistSession {
  id                   String          @id @default(uuid()) @db.Uuid
  bookingId            String          @unique @db.Uuid
  status               SessionStatus   @default(SCHEDULED)
  actualStartedAt      DateTime?       @db.Timestamptz(6)
  actualEndedAt        DateTime?       @db.Timestamptz(6)
  attendanceVerified   Boolean         @default(false)
  attendanceVerifiedAt DateTime?       @db.Timestamptz(6)
  attendanceSummary    Json?
  recordingStatus      RecordingStatus @default(NOT_APPLICABLE)
  recordingObjectKey   String?         @db.VarChar(512)
  recordingStartedAt   DateTime?       @db.Timestamptz(6)
  recordingEndedAt     DateTime?       @db.Timestamptz(6)
  /// Live screen: psych-only private notes (never shown to client).
  privateNotes         String?         @db.Text
  privateNoteTags      String[]        @default([])
  /// After-session outcome; null until psych submits aftercare.
  riskLevel            SessionRiskLevel?
  /// AudioTrack.id values recommended to the client (UUID strings).
  recommendedAudioIds  String[]        @default([])
  followUpRecommended  Boolean         @default(false)
  followUpNote         String?         @db.VarChar(1000)
  /// Short note visible to the client after the session.
  clientFacingNote     String?         @db.VarChar(2000)
  aftercareSubmittedAt DateTime?       @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)

  booking           PsychologistBooking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  attendanceEvents  AttendanceEvent[]
  recordingConsents SessionRecordingConsent[]
  complaints        SessionComplaint[]
  payout            PsychologistPayout?

  @@index([status])
  @@index([riskLevel])
}

model SessionRecordingConsent {
  id                    String          @id @default(uuid()) @db.Uuid
  sessionId             String          @db.Uuid
  participantRole       ParticipantRole
  userId                String?         @db.Uuid
  psychologistProfileId String?         @db.Uuid
  consentedAt           DateTime        @db.Timestamptz(6)
  revokedAt             DateTime?       @db.Timestamptz(6)

  session      PsychologistSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user         User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  psychologist PsychologistProfile? @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)

  @@unique([sessionId, participantRole])
  @@index([sessionId])
}

model AttendanceEvent {
  id                    String              @id @default(uuid()) @db.Uuid
  sessionId             String              @db.Uuid
  participantRole       ParticipantRole
  userId                String?             @db.Uuid
  psychologistProfileId String?             @db.Uuid
  eventType             AttendanceEventType
  occurredAt            DateTime            @db.Timestamptz(6)
  metadata              Json?
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)

  session      PsychologistSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user         User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  psychologist PsychologistProfile? @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)

  @@index([sessionId, occurredAt])
  @@index([sessionId, participantRole, occurredAt])
}

model SubscriptionPlan {
  id              String       @id @default(uuid()) @db.Uuid
  code            String       @unique @db.VarChar(32)
  name            String       @db.VarChar(80)
  priceMinorUnits Int
  currency        String       @db.Char(3)
  interval        PlanInterval
  durationDays    Int
  isActive        Boolean      @default(true)
  razorpayPlanId  String?      @db.VarChar(64)
  stripePriceId   String?      @db.VarChar(64)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  planId                 String             @db.Uuid
  billingMode            BillingMode
  status                 SubscriptionStatus @default(PENDING)
  provider               PaymentProvider
  providerSubscriptionId String?            @db.VarChar(128)
  trialStartsAt          DateTime?          @db.Timestamptz(6)
  trialEndsAt            DateTime?          @db.Timestamptz(6)
  currentPeriodStart     DateTime?          @db.Timestamptz(6)
  currentPeriodEnd       DateTime?          @db.Timestamptz(6)
  cancelledAt            DateTime?          @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(6)

  user   User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([userId, status])
}

model Order {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  purpose          OrderPurpose
  bookingId        String?         @db.Uuid
  subscriptionId   String?         @db.Uuid
  amountMinorUnits Int
  currency         String          @db.Char(3)
  provider         PaymentProvider
  providerOrderId  String?         @db.VarChar(128)
  status           OrderStatus     @default(CREATED)
  idempotencyKey   String?         @unique @db.VarChar(64)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(6)

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking      PsychologistBooking?  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  subscription Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@index([userId, status])
  @@index([bookingId])
  @@index([subscriptionId])
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @db.Uuid
  provider          PaymentProvider
  providerPaymentId String?         @db.VarChar(128)
  amountMinorUnits  Int
  currency          String          @db.Char(3)
  status            PaymentStatus   @default(PENDING)
  providerStatus    String?         @db.VarChar(64)
  paidAt            DateTime?       @db.Timestamptz(6)
  failedAt          DateTime?       @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds       PaymentRefund[]
  statusHistory PaymentStatusHistory[]
  payouts       PsychologistPayout[]

  @@index([orderId, status])
}

model PaymentRefund {
  id               String         @id @default(uuid()) @db.Uuid
  paymentId        String         @db.Uuid
  provider         PaymentProvider
  amountMinorUnits Int
  currency         String         @db.Char(3)
  reason           RefundReason
  reasonDetail     String?        @db.VarChar(1000)
  providerRefundId String?        @db.VarChar(128)
  status           RefundStatus   @default(PENDING)
  idempotencyKey   String?        @unique @db.VarChar(64)
  initiatedAt      DateTime       @default(now()) @db.Timestamptz(6)
  completedAt      DateTime?      @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)

  payment   Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  complaint SessionComplaint?

  @@index([paymentId, status])
}

model PaymentStatusHistory {
  id              String                    @id @default(uuid()) @db.Uuid
  paymentId       String                    @db.Uuid
  oldStatus       PaymentStatus?
  newStatus       PaymentStatus
  source          PaymentStatusChangeSource
  providerEventId String?                   @db.VarChar(128)
  metadata        Json?
  changedAt       DateTime                  @default(now()) @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, changedAt])
}

model PaymentWebhookEvent {
  id               String                  @id @default(uuid()) @db.Uuid
  provider         PaymentProvider
  providerEventId  String                  @db.VarChar(128)
  eventType        String                  @db.VarChar(128)
  payload          Json
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  receivedAt       DateTime                @default(now()) @db.Timestamptz(6)
  processedAt      DateTime?               @db.Timestamptz(6)
  lastError        String?                 @db.VarChar(2000)

  @@unique([provider, providerEventId])
  @@index([processingStatus, receivedAt])
}

model PsychologistPayout {
  id                          String          @id @default(uuid()) @db.Uuid
  sessionId                   String          @unique @db.Uuid
  psychologistProfileId       String          @db.Uuid
  paymentId                   String          @db.Uuid
  grossAmountMinorUnits       Int
  psychologistShareMinorUnits Int
  platformShareMinorUnits     Int
  splitVersion                String          @db.VarChar(32)
  currency                    String          @db.Char(3)
  provider                    PaymentProvider
  providerTransferId          String?         @db.VarChar(128)
  status                      PayoutStatus    @default(PENDING)
  initiatedAt                 DateTime?       @db.Timestamptz(6)
  paidAt                      DateTime?       @db.Timestamptz(6)
  lastError                   String?         @db.VarChar(2000)
  createdAt                   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime        @updatedAt @db.Timestamptz(6)

  session      PsychologistSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  psychologist PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)
  payment      Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([psychologistProfileId, status])
}

model SessionComplaint {
  id                     String            @id @default(uuid()) @db.Uuid
  sessionId              String            @db.Uuid
  userId                 String            @db.Uuid
  category               ComplaintCategory
  description            String            @db.Text
  status                 ComplaintStatus   @default(OPEN)
  reviewerAccountId      String?           @db.Uuid
  decision               ComplaintDecision?
  decisionRationale      String?           @db.Text
  paymentRefundId        String?           @unique @db.Uuid
  replacementBookingId   String?           @unique @db.Uuid
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)
  resolvedAt             DateTime?         @db.Timestamptz(6)

  session            PsychologistSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewer           Account?            @relation(fields: [reviewerAccountId], references: [id], onDelete: SetNull)
  paymentRefund      PaymentRefund?      @relation(fields: [paymentRefundId], references: [id], onDelete: SetNull)
  replacementBooking PsychologistBooking? @relation("ComplaintReplacementBooking", fields: [replacementBookingId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([status])
  @@index([reviewerAccountId])
}

// --- Saathi AI companion (client JWT / User plane; not staff Account) ---

enum SaathiMessageRole {
  USER
  ASSISTANT
}

enum SaathiMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

model SaathiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages SaathiMessage[]
  memory   SaathiMemory?

  @@index([userId, updatedAt])
}

model SaathiMessage {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @db.Uuid
  role           SaathiMessageRole
  content        String              @db.Text
  status         SaathiMessageStatus @default(COMPLETED)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)

  conversation SaathiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model SaathiMemory {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @unique @db.Uuid
  summary        String   @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  conversation SaathiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// --- Phase 2: Mood (plaintext) + Diary (E2E ciphertext) + Audio catalogue ---

model Mood {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(32)
  userMoods UserMood[]
}

model UserMood {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  moodId    String   @db.Uuid
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  mood Mood @relation(fields: [moodId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
}

model DiaryEntry {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  entryDate         DateTime @db.Date
  ciphertext        Bytes
  nonce             Bytes
  encryptionVersion Int      @default(1)
  schemaVersion     Int      @default(1)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, entryDate])
}

enum AudioLanguage {
  HINDI
  ENGLISH
}

enum AudioPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/** Per-track unlock: FREE = any signed-in user; TRIAL = trial/active; SUBSCRIPTION = paid ACTIVE only. */
enum AudioAccessTier {
  FREE
  TRIAL
  SUBSCRIPTION
}

enum AudioCategory {
  STRESS
  ANXIETY
  SLEEP
  FOCUS
  RELATIONSHIPS
  BODY
  HER_CYCLE
}

model AudioTrack {
  id              String             @id @default(uuid()) @db.Uuid
  title           String             @db.VarChar(160)
  description     String?            @db.VarChar(1000)
  category        AudioCategory
  status          AudioPublishStatus @default(DRAFT)
  accessTier      AudioAccessTier    @default(TRIAL)
  durationSeconds Int?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  versions         AudioVersion[]
  feelingTags      AudioFeelingTag[]
  lifeStageTargets AudioLifeStageTarget[]
  genderTargets    AudioGenderTarget[]
}

model AudioVersion {
  id              String        @id @default(uuid()) @db.Uuid
  audioTrackId    String        @db.Uuid
  language        AudioLanguage
  r2ObjectKey     String        @db.VarChar(512)
  mimeType        String        @db.VarChar(100)
  durationSeconds Int?
  byteSize        Int?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  track AudioTrack @relation(fields: [audioTrackId], references: [id], onDelete: Cascade)

  @@unique([audioTrackId, language])
}

model AudioFeelingTag {
  audioTrackId String          @db.Uuid
  feeling      StartingFeeling
  track        AudioTrack      @relation(fields: [audioTrackId], references: [id], onDelete: Cascade)

  @@id([audioTrackId, feeling])
}

model AudioLifeStageTarget {
  audioTrackId String    @db.Uuid
  lifeStage    LifeStage
  track        AudioTrack @relation(fields: [audioTrackId], references: [id], onDelete: Cascade)

  @@id([audioTrackId, lifeStage])
}

model AudioGenderTarget {
  audioTrackId String     @db.Uuid
  gender       Gender
  track        AudioTrack @relation(fields: [audioTrackId], references: [id], onDelete: Cascade)

  @@id([audioTrackId, gender])
}
