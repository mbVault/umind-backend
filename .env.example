PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/umind_dev?schema=public"
CORS_ORIGIN="http://localhost:3000"

# Anonymous client auth (unchanged)
JWT_SECRET="change-me-to-at-least-32-random-characters"
TOKEN_PEPPER="change-me-token-pepper"
RECOVERY_PEPPER="change-me-recovery-pepper"
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Staff SuperTokens (self-hosted Core). Empty CONNECTION_URI disables ST middleware.
# Auth recipes are mounted at SUPERTOKENS_API_BASE_PATH (default /api/v1/staff/auth).
# Existing client routes remain at /api/auth/*.
#
# Local Core (docker compose): bind is 127.0.0.1:3567 → backend on the host uses localhost.
# If the Node API also ran inside Compose on the same network, use http://supertokens:3567 instead.
# SUPERTOKENS_API_KEY must match API_KEYS / SUPERTOKENS_API_KEY in .env.docker.
# See docs/STAFF_AUTH_SETUP.md and .env.docker.example.
SUPERTOKENS_CONNECTION_URI="http://localhost:3567"
SUPERTOKENS_API_KEY="change-me-generate-with-openssl-rand-hex-32"
SUPERTOKENS_APP_NAME="U Mind Staff"
SUPERTOKENS_API_DOMAIN="http://localhost:4000"
SUPERTOKENS_WEBSITE_DOMAIN="http://localhost:3000"
SUPERTOKENS_API_BASE_PATH="/api/v1/staff/auth"
SUPERTOKENS_WEBSITE_BASE_PATH="/auth"

# Staff social login (optional — leave empty to hide Google/Apple on login UI)
STAFF_GOOGLE_CLIENT_ID=
STAFF_GOOGLE_CLIENT_SECRET=
STAFF_APPLE_CLIENT_ID=
STAFF_APPLE_KEY_ID=
STAFF_APPLE_TEAM_ID=
# PEM with \n escapes, e.g. -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
STAFF_APPLE_PRIVATE_KEY=

# Test-only: allow X-Test-SuperTokens-User-Id header instead of a live ST session
STAFF_AUTH_TEST_BYPASS=false

# Object storage: `local` filesystem for development; Cloudflare R2 later.
OBJECT_STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./.local-storage
LOCAL_STORAGE_URL_TTL_SEC=900
PUBLIC_API_BASE_URL=http://localhost:4000
# Legacy flag (prefer OBJECT_STORAGE_DRIVER)
OBJECT_STORAGE_CONFIGURED=false

# Admin invitation tokens
INVITATION_TOKEN_TTL_HOURS=72
INVITATION_TOKEN_PEPPER="change-me-invitation-pepper"

# Payments (test mode). Secrets stay on backend only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Local dev provider hint (IN = Razorpay default). Do not trust client-supplied country in prod.
PAYMENT_DEV_COUNTRY=IN

# Saathi AI (stub provider by default — no external calls)
SAATHI_LLM_PROVIDER=stub
# SAATHI_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# SAATHI_LLM_MODEL=gpt-4o-mini
# SAATHI_LLM_TIMEOUT_MS=30000
# SAATHI_MESSAGE_RATE_LIMIT_PER_MIN=30

