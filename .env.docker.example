# Copy to `.env.docker` (gitignored) and fill in local values.
# Used by `docker compose --env-file .env.docker up -d`.
#
# Must match backend `.env`:
#   SUPERTOKENS_API_KEY  ==  this file's SUPERTOKENS_API_KEY (Core API_KEYS)
#   SUPERTOKENS_CONNECTION_URI=http://localhost:3567  (backend on host)

# Generate with: openssl rand -hex 32
# Must be ≥20 chars; letters, digits, = and - only (SuperTokens Core rule).
SUPERTOKENS_API_KEY=change-me-generate-with-openssl-rand-hex-32

# Host Postgres as seen FROM the Core container.
# On Docker Desktop (Windows/Mac): host.docker.internal
# On Linux: often host.docker.internal (compose sets host-gateway) or the docker bridge IP.
SUPERTOKENS_POSTGRES_HOST=host.docker.internal
SUPERTOKENS_POSTGRES_PORT=5432

# Reuse your local Postgres role, or create a dedicated role with CREATEDB.
# Do not point POSTGRESQL_DATABASE_NAME / SUPERTOKENS_POSTGRES_DB at umind_dev.
SUPERTOKENS_POSTGRES_USER=postgres
SUPERTOKENS_POSTGRES_PASSWORD=your_postgres_password_here
SUPERTOKENS_POSTGRES_DB=umind_supertokens
